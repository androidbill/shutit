{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['createdAt'])"
      }
    },
    "pulses": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "meta": {
      "version": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString() && newData.val().length < 20"
      }
    }
  }
}
